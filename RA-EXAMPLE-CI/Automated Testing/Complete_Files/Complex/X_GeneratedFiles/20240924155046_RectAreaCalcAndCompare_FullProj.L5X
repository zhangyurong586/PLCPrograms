<LocalTags/>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[


Utilize LDSDK to set values for box_width & box_length and to get box_area's valu]]>
</Comment>
<Text>
<![CDATA[MUL(box_width,box_length,box_area);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
Use LDSDK to set compareValue_for_box_area's value and to get area_comparison_result.

]]>
</Comment>
<Text>
<![CDATA[GT(compareValue_for_box_Area,box_area)OTE(area_comparison_result);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
